{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/concreteballs/YJ64-Browser-Council/blob/research/initial-technical-audit/schemas/browser-council-v1.schema.json",
  "title": "Browser Council internal API and event contracts v1",
  "description": "Internal Browser Council contract. This schema is separate from, and does not modify, yj64.council-api.v1.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "execution_status": {
      "enum": [
        "queued",
        "running",
        "blocked",
        "failed",
        "cancelled",
        "completed"
      ]
    },
    "analytical_outcome": {
      "enum": [
        "consensus",
        "qualified_consensus",
        "unresolved_disagreement",
        "insufficient_evidence"
      ]
    },
    "connection_type": {
      "enum": [
        "api",
        "browser_session"
      ]
    },
    "event_type": {
      "enum": [
        "workspace.created",
        "conversation.created",
        "message.created",
        "message.delta",
        "message.completed",
        "run.queued",
        "run.started",
        "run.phase_changed",
        "participant.started",
        "participant.completed",
        "run.completed",
        "run.blocked",
        "run.failed",
        "run.cancelled",
        "connection.health_changed",
        "council.created",
        "council.participant_added",
        "council_run.queued",
        "council_run.started",
        "council_run.retry_scheduled",
        "council_run.completed",
        "council_run.failed",
        "council_run.cancelled",
        "council_run.cancel_requested",
        "worker_job.cancelled",
        "worker_job.cancel_requested"
      ]
    },
    "resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id"
      ],
      "properties": {
        "workspace_id": {
          "$ref": "#/$defs/id"
        },
        "conversation_id": {
          "$ref": "#/$defs/id"
        },
        "council_id": {
          "$ref": "#/$defs/id"
        },
        "participant_id": {
          "$ref": "#/$defs/id"
        },
        "provider_connection_id": {
          "$ref": "#/$defs/id"
        },
        "browser_profile_id": {
          "$ref": "#/$defs/id"
        },
        "browser_session_id": {
          "$ref": "#/$defs/id"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "turn_id": {
          "$ref": "#/$defs/id"
        },
        "message_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "event_id",
        "workspace_id",
        "sequence",
        "type",
        "occurred_at",
        "resource",
        "payload"
      ],
      "properties": {
        "protocol_version": {
          "const": "browser-council.internal.v1"
        },
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "workspace_id": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "$ref": "#/$defs/event_type"
        },
        "occurred_at": {
          "$ref": "#/$defs/timestamp"
        },
        "resource": {
          "$ref": "#/$defs/resource_ref"
        },
        "correlation_id": {
          "$ref": "#/$defs/id"
        },
        "causation_id": {
          "$ref": "#/$defs/id"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "create_workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "create_conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "provider_connection_id"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "provider_connection_id": {
          "$ref": "#/$defs/id"
        },
        "system_instructions": {
          "type": "string",
          "maxLength": 20000
        }
      }
    },
    "post_message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_message_id",
        "content",
        "idempotency_key"
      ],
      "properties": {
        "client_message_id": {
          "$ref": "#/$defs/id"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "attachments": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "media_type"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "#/$defs/id"
              },
              "media_type": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    "create_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        }
      }
    },
    "run_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "$ref": "#/$defs/execution_status"
        },
        "outcome": {
          "oneOf": [
            {
              "$ref": "#/$defs/analytical_outcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "type": "string",
          "maxLength": 80
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "failure_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "failure_message": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "$ref": "#/$defs/analytical_outcome"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "completed"
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "provider_connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_connection_id",
        "workspace_id",
        "connection_type",
        "provider_key",
        "display_name",
        "status"
      ],
      "properties": {
        "provider_connection_id": {
          "$ref": "#/$defs/id"
        },
        "workspace_id": {
          "$ref": "#/$defs/id"
        },
        "connection_type": {
          "$ref": "#/$defs/connection_type"
        },
        "provider_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "enum": [
            "unconfigured",
            "ready",
            "degraded",
            "logged_out",
            "challenge_required",
            "blocked",
            "rate_limited",
            "uncertain",
            "failed",
            "revoked"
          ]
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "secret_ref": {
          "type": "string",
          "maxLength": 256,
          "description": "Opaque server-side secret-manager reference only; never a credential value."
        },
        "browser_profile_id": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "connection_type": {
                "const": "api"
              }
            },
            "required": [
              "connection_type"
            ]
          },
          "then": {
            "not": {
              "required": [
                "browser_profile_id"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "connection_type": {
                "const": "browser_session"
              }
            },
            "required": [
              "connection_type"
            ]
          },
          "then": {
            "required": [
              "browser_profile_id"
            ]
          }
        }
      ]
    },
    "council_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "status",
        "outcome",
        "summary",
        "participant_positions",
        "dissent",
        "claims",
        "evidence_refs",
        "assumptions",
        "limitations"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "const": "completed"
        },
        "outcome": {
          "$ref": "#/$defs/analytical_outcome"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        },
        "participant_positions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "participant_id",
              "position",
              "rationale"
            ],
            "properties": {
              "participant_id": {
                "$ref": "#/$defs/id"
              },
              "position": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "claim_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        "dissent": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "participant_id",
              "reason"
            ],
            "properties": {
              "participant_id": {
                "$ref": "#/$defs/id"
              },
              "reason": {
                "type": "string"
              },
              "claim_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "statement",
              "epistemic_type"
            ],
            "properties": {
              "claim_id": {
                "$ref": "#/$defs/id"
              },
              "statement": {
                "type": "string"
              },
              "epistemic_type": {
                "enum": [
                  "observation",
                  "source_fact",
                  "inference",
                  "hypothesis",
                  "test_result",
                  "model_assertion"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "create_council": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "create_council_participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_connection_id",
        "display_name",
        "position"
      ],
      "properties": {
        "provider_connection_id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "model_identifier": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
